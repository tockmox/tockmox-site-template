# This is a TEMPLATE. It must stay safe to make public.
# Real secrets never live here as plaintext ... only SealedSecrets, which are
# encrypted to your cluster's key and safe to commit.
*.tgz
.DS_Store

# Never commit an unsealed secret, a kubeconfig, or a token.
*.kubeconfig
kubeconfig
secrets/*.plain.yaml
secrets/*.unsealed.yaml
*.pem
*.key
.env

# Local handoff / apply scripts. Generated per working session, run once, deleted.
# Ignored as a class rather than by prefix so a new script shape never starts life
# unignored. Note that gitignore does not affect already-tracked files.
_*.sh
